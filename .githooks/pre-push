#!/usr/bin/env bash
# Blocks a push when a banned term appears in tracked files or in a fresh production build.
# Enabled per clone with: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: building to check the output for banned terms…"
pnpm build > /dev/null
pnpm check:terms
